{
  "expo": {
    "name": "FundTracker",
    "slug": "FundTracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fundtracker.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121212"
      },
      "package": "com.fundtracker.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow FundTracker to access your photos to import fund screenshots.",
          "cameraPermission": "Allow FundTracker to use the camera to capture fund screenshots."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9bbdc598-5469-44ea-b1cf-b83cc9c36745"
      }
    },
    "owner": "ustchope"
  }
}
